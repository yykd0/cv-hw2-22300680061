# Shared experiment defaults. Override any variable before running scripts.

PROJECT_NAME="HW3_Q1_2DGS_AIGC"
SEED="20260614"

# Object A: 2DGS reconstruction.
MIPNERF360_URL="https://storage.googleapis.com/gresearch/refraw360/360_v2.zip"
MIPNERF360_SCENE="bicycle"
TWODGS_ITERATIONS="30000"
TWODGS_MESH_RES="1024"
TWODGS_IMAGE_DIR="images_4"

# Object B: threestudio SDS text-to-3D.
THREESTUDIO_PROMPT="a DSLR photo of a porcelain teapot with blue floral patterns, isolated object, white background"
THREESTUDIO_CONFIG="configs/dreamfusion-sd.yaml"
THREESTUDIO_STEPS="10000"

# Object C: Magic123 image-to-3D.
MAGIC123_PROMPT="A high-resolution DSLR image of a small red ceramic dragon figurine"
MAGIC123_COARSE_ITERS="5000"
MAGIC123_FINE_ITERS="5000"
MAGIC123_LAMBDA_GUIDANCE_COARSE="1.0 40"
MAGIC123_LAMBDA_GUIDANCE_FINE="1e-3 0.01"

# Hosting links are read from configs/submission_links.json.
